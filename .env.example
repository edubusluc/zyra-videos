# Copia este archivo como .env y rellena (el .env nunca se sube a git).
# Voz en off: Azure Speech (voces nativas de España, plan gratuito) o ElevenLabs. Con AZURE_SPEECH_KEY se usa Azure aunque haya clave de ElevenLabs;
# para forzar uno: VOZ_PROVEEDOR=azure | elevenlabs
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# AZURE_SPEECH_VOICE=es-ES-ElviraNeural   # mujer; es-ES-AlvaroNeural (hombre), es-ES-XimenaNeural, es-ES-AbrilNeural...
# AZURE_SPEECH_RATE=+5%                   # velocidad
# AZURE_SPEECH_PITCH=+1st                 # tono
# AZURE_SPEECH_STYLE=                     # solo si la voz admite estilos (cheerful, excited...)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Perfil de voz: expresivo (por defecto, entonación marcada) | natural (más contenida) | neutro (ajustes de la propia voz).
# ELEVENLABS_PERFIL=expresivo
# Ajustes sueltos opcionales; si los pones, mandan sobre el perfil:
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.3         # 0-1: bajo = más expresiva
# ELEVENLABS_SIMILARITY=0.75       # 0-1: parecido a la voz original
# ELEVENLABS_STYLE=0.55            # 0-1: más estilo = más énfasis (cuesta algo de estabilidad)
# ELEVENLABS_SPEED=1.0             # 0.7-1.2
# ELEVENLABS_SPEAKER_BOOST=true
# Solo si prefieres la API de Anthropic al CLI de Claude (de pago por uso):
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=
