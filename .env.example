# Copia este archivo como .env y rellena (el .env nunca se sube a git).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Ajustes de la voz (todos opcionales; si los quitas, vale lo configurado en la voz):
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.45        # 0-1: bajo = más expresiva, alto = más monótona
# ELEVENLABS_SIMILARITY=0.8        # 0-1: parecido a la voz original
# ELEVENLABS_STYLE=0.3             # 0-1: exageración del estilo (más lenta, 0 = neutra)
# ELEVENLABS_SPEED=1.05            # 0.7-1.2: velocidad de habla
# ELEVENLABS_SPEAKER_BOOST=true
# Solo si prefieres la API de Anthropic al CLI de Claude (de pago por uso):
# ANTHROPIC_API_KEY=
# GITHUB_TOKEN=
